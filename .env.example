# Required — always quote values to avoid shell interpretation
RESTICO_REPOSITORY="rclone:filen:backups/restic/mymachine"
RESTICO_PASSWORD_FILE="$HOME/.config/restico/restic-password"
RESTICO_HOSTNAME="my-server"
RESTICO_BACKUP_PATHS="/home"

# Optional — use instead of RESTICO_PASSWORD_FILE
# RESTICO_PASSWORD_COMMAND="command-that-outputs-password"
# RESTICO_PASSWORD="your-password-with-^!%@chars"

# Optional — exclude patterns
# RESTICO_EXCLUDE_FILE="$HOME/.config/restico/excludes.txt"

# Optional — ntfy notifications (set both or neither)
# RESTICO_NTFY_URL="https://ntfy.sh/topic"
# RESTICO_NTFY_TOKEN="tk-your-token"

# Optional — override default paths
# RESTICO_CONFIG_DIR="$HOME/.config/restico"
# RESTICO_CACHE_DIR="$HOME/.cache/restico"
# RESTICO_LOG_FILE="$HOME/.cache/restico/restico.log"
